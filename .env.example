# ---------------------------------------------------------------------------
# .env.example — SAFE PLACEHOLDERS ONLY.
#
# Copy to `.env` (git-ignored) and fill in real values locally, or provide the
# same names through the process environment / a secret manager in deployment.
# Nothing in this file is a real credential; every value is either empty, a
# documented default, or an obvious placeholder.
#
# Every name below maps 1:1 to a field in backend/app/config.py (case
# insensitive).  Unknown names are ignored.  Leaving a line commented out means
# "use the built-in default".
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
# Default (unset): sqlite:///<repo>/var/auditor.db  — zero-dependency dev/demo.
# Production target is PostgreSQL with JSONB columns:
# DATABASE_URL=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/auditor
# DATABASE_URL=sqlite:///var/auditor.db
DATABASE_ECHO=false

# --- GitLab REST API ----------------------------------------------------------
# Leave both empty to run without GitLab: the API then reports
# "gitlab=not configured (demo mode available)" and audits use the bundled,
# clearly-labelled local fixture.  A real deployment sets a project-scoped PAT
# with the MINIMUM scope needed (read_api is enough for the read-mostly audit
# flow; never use a token with write_repository for read-only auditing).
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_API_VERSION=v4
GITLAB_TIMEOUT_SECONDS=20
GITLAB_MAX_RETRIES=2
# Comma-separated allow-list of project ids the auditor may touch.
# Empty = any project the token can read (still server-side authorized).
GITLAB_ALLOWED_PROJECT_IDS=

# --- GitLab Duo Agent Platform (mandatory integration) ------------------------
# DUO_ENABLED=true only activates the live Flows API client when GITLAB_URL and
# GITLAB_TOKEN are also set for a Premium/Ultimate instance with the Duo Agent
# Platform turned on.  Until then the product reports the missing prerequisite
# honestly and never simulates a Duo result.
DUO_ENABLED=false
DUO_FLOW_DEFINITION=change-audit/v1
DUO_ENVIRONMENT=ambient            # custom Flow Registry v1 flows require "ambient"
DUO_POLL_INTERVAL_SECONDS=3
DUO_POLL_TIMEOUT_SECONDS=900
# Privilege ids: 1=read_write_files 2=read_only_gitlab 3=read_write_gitlab
# 4=run_commands.  The audit flow is read-mostly on GitLab: it must never push
# to a default branch, merge, or deploy.
DUO_AGENT_PRIVILEGES=1,2,4
DUO_PRE_APPROVED_PRIVILEGES=2
DUO_FLOW_CONFIG_PATH=agents/flows/change-audit/flow.yaml
# DUO_AI_CATALOG_ITEM_CONSUMER_ID=

# --- labelled local demo mode --------------------------------------------------
DEMO_ENABLED=true
# DEMO_REPO_PATH=examples/discount-service
DEMO_SOURCE_BRANCH=feature/refactor-discount
DEMO_TARGET_BRANCH=main
DEMO_MERGE_REQUEST_IID=1

# --- untrusted-code execution ----------------------------------------------------
# auto = docker executor when Docker is present, else linux namespaces,
# else rlimit-only process isolation (weakest; documented as NOT a hard
# security boundary — see docs/security.md).
SANDBOX_MODE=auto
# SANDBOX_ROOT=
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_MB=1024
SANDBOX_CPU_SECONDS=60
SANDBOX_MAX_FILE_MB=32
SANDBOX_MAX_PROCESSES=256
SANDBOX_ALLOW_NETWORK=false
SANDBOX_KEEP_WORKSPACES=false
SANDBOX_DOCKER_IMAGE=python:3.12-slim

# --- audit workflow ----------------------------------------------------------------
TEST_FRAMEWORK=pytest
MAX_FINDINGS_PER_AUDIT=25
AUTO_GENERATE_TESTS=true
# Human approval is a hard product requirement.  Never set this to true.
AUTO_APPROVE_PATCHES=false
AUDIT_WORKER_CONCURRENCY=2

# --- API -----------------------------------------------------------------------------
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=600
# Optional bearer token required by mutating endpoints.  Empty = open in dev;
# set a real random value in any shared deployment.
API_AUTH_TOKEN=
